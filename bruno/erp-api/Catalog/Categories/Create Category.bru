meta {
  name: Create Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/catalog/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "code": "RAW",
    "name": "Raw materials",
    "description": "Inputs used to manufacture products"  
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("categoryId", res.body.id);
  }
}
