meta {
  name: Create Contact Person
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/contact-persons
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Maria Buyer",
    "customerId": "{{customerId}}",
    "contact": {
      "email": "maria@customer.example",
      "phone": "11933334444"
    }
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("contactPersonId", res.body.id);
  }
}
