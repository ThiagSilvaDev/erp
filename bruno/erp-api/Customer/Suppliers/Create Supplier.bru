meta {
  name: Create Supplier
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/suppliers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Industrial Supplier",
    "document": "22333444000150",
    "companyId": "{{companyId}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("supplierId", res.body.id);
  }
}
