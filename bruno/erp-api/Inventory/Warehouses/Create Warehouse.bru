meta {
  name: Create Warehouse
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/inventory/warehouses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "code": "MAIN", "name": "Main Warehouse" }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("warehouseId", res.body.id);
  }
}
