meta { name: Create Stock Movement type: http seq: 1 }
post { url: {{baseUrl}}/api/v1/inventory/stock-movements body: json auth: bearer }
auth:bearer { token: {{accessToken}} }
headers { Content-Type: application/json }
body:json {
  { "productId": "{{productId}}", "warehouseId": "{{warehouseId}}", "quantity": 100, "reason": "Initial stock" }
}
script:post-response {
  if (res.status === 201 && res.body?.id) { bru.setEnvVar("stockMovementId", res.body.id); }
}
