meta {
  name: Create Vehicle
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/logistics/vehicles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "plate": "ABC1234", "description": "Box truck", "capacity": 1000 }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("vehicleId", res.body.id);
  }
}
