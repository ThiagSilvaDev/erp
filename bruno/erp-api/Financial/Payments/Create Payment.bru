meta {
  name: Create Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/financial/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "invoiceId": "{{invoiceId}}", "amount": 21.00, "paidAt": "2026-05-15" }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("paymentId", res.body.id);
  }
}
