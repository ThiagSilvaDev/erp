meta {
  name: Create Invoice
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/financial/invoices
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "billingPartyType": "CUSTOMER",
    "billingPartyId": "{{customerId}}",
    "salesOrderId": null,
    "amount": 21.00,
    "currencyCode": "BRL",
    "dueDate": "2026-06-01"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("invoiceId", res.body.id);
  }
}
