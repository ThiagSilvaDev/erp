meta {
  name: Create Driver
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/logistics/drivers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "name": "Alex Driver", "licenseNumber": "CNH-001", "phone": "11999999999" }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("driverId", res.body.id);
  }
}
