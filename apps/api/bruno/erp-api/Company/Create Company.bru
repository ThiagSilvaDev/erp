meta {
  name: Create Company
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/companies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "legalName": "Acme Industria Ltda",
    "tradeName": "Acme",
    "cnpj": "11.222.333/0001-81",
    "type": "FACTORY",
    "contact": {
      "email": "financeiro@acme.example",
      "phone": "11912345678"
    },
    "address": {
      "postalCode": "01310-100",
      "street": "Avenida Paulista",
      "number": "1000",
      "complement": "Conjunto 101",
      "district": "Bela Vista",
      "city": "Sao Paulo",
      "region": "SP",
      "country": "BR"
    }
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("companyId", res.body.id);
  }
}
