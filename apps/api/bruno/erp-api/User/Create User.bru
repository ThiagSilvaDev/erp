meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Maria",
    "lastName": "Silva",
    "email": "maria.silva@acme.example",
    "phone": "11987654321",
    "birthDate": "1990-05-20",
    "role": "MANAGER",
    "companyId": "{{companyId}}",
    "password": "ChangeMe123!"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.id) {
    bru.setEnvVar("userId", res.body.id);
  }
}
